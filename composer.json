{
    "name": "seryak/yazar",
    "type": "library",
    "description": "Static site generator engine for Laravel: Markdown content imported into Eloquent documents and rendered through Blade.",
    "keywords": ["framework", "laravel", "static-site-generator", "markdown"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0",
        "illuminate/contracts": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/support": "^12.0",
        "graham-campbell/markdown": "^16.0",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "laravel/framework": "^12.55",
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench-core": "^10.0",
        "phpunit/phpunit": "^11.5.15"
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "Yazar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Yazar\\YazarServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
